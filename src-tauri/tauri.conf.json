{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Anomalize",
	"version": "0.1.0",
	"identifier": "com.anomalize.desktop",
	"build": {
		"beforeDevCommand": "pnpm run dev:tauri",
		"beforeBuildCommand": "pnpm run build:tauri",
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173"
	},
	"app": {
		"windows": [
			{
				"title": "Anomalize",
				"width": 1440,
				"height": 920,
				"resizable": true
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": [
			"../src-python/models/onnx/anomaly_xgb.onnx",
			"../src-python/models/onnx/anomaly_brf.onnx",
			"../src-python/models/onnx/category_xgb.onnx",
			"../src-python/models/onnx/bundle_metadata.json"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.ico",
			"icons/icon.icns"
		]
	}
}
