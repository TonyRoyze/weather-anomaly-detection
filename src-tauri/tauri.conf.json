{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Anomalize",
	"version": "0.1.0",
	"identifier": "com.anomalize.desktop",
	"build": {
		"beforeDevCommand": "pnpm run dev",
		"beforeBuildCommand": "pnpm run build",
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173"
	},
	"app": {
		"windows": [
			{
				"title": "Anomalize",
				"width": 1440,
				"height": 920,
				"resizable": true
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": []
	}
}
